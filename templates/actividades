{% extends 'index.html' %}
{% block Actividades%}
{% load ajudatotal %}

<div class="list-container">
    <div class="modern-card" style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;"><i class="fas fa-filter mr-2"></i> Filtros de Actividades</h3>
        <form action="/tibl/buscaactividades" method="GET"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; align-items: flex-end;">
            <div>
                <label
                    style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Nome</label>
                <input type="text" name="nomev"
                    style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <div>
                <label
                    style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Designação</label>
                <select name="actividadev"
                    style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">------------</option>
                    {% if listaactividades %}
                    {% for x in listaactividades %}
                    <option value="{{ x.id }}">{{ x.designacao }}</option>
                    {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div>
                <label
                    style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Mês/Ano</label>
                <div style="display: flex; gap: 0.5rem;">
                    <select name="mesv"
                        style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                        <option value="0">Mês</option>
                        {% if listameses %}
                        {% for x, y in listameses.items %}
                        <option value="{{ x }}">{{ y }}</option>
                        {% endfor %}
                        {% endif %}
                    </select>
                    <select name="anov"
                        style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                        <option value="0">Ano</option>
                        <option value="2025">2025</option>
                        <option value="2026" selected>2026</option>
                    </select>
                </div>
            </div>
            <input type="hidden" name="pagina" value="1">
            <button type="submit" class="bt-primary" style="padding: 0.6rem;">
                <i class="fas fa-search"></i> Filtrar
            </button>
        </form>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Cronograma de
            Actividades</h2>
        <a href="/tibl/actividades/criar/" class="bt-primary"
            style="padding: 0.5rem 1.5rem; font-size: 0.9rem; background-color: var(--accent); color: var(--primary-dark);">
            <i class="fas fa-plus"></i> Nova Actividade
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Actividade / Local</th>
                    <th style="text-align: center;">Horário</th>
                    <th style="text-align: center;">Data</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: var(--primary-dark);">{{ x.designacao }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);"><i class="fas fa-map-marker-alt"
                                style="font-size: 0.7rem;"></i> {{ x.localactividade|default:"Sede" }}</div>
                    </td>
                    <td style="text-align: center;">
                        <span style="font-size: 0.85rem; color: var(--text-main);">
                            <i class="far fa-clock"></i> {{ x.inicio }} - {{ x.fim }}
                        </span>
                    </td>
                    <td style="text-align: center;">
                        <div style="font-weight: 600; color: var(--primary);">{{ x.data|date:"d/m/Y"|default:x.data }}
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <a href="/tibl/actividades/detalhe/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--primary); color: white !important;">
                            <i class="fas fa-info-circle"></i> Detalhes
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 3rem;">
        <i class="fas fa-calendar-times" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted);">Nenhuma actividade encontrada para este período.</p>
    </div>
    {% endif %}
</div>

{% endblock %}