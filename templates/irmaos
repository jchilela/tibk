{% extends 'index.html' %}
{% block Irmaos %}

<div class="list-container">
    <div class="modern-card" style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;"><i class="fas fa-filter mr-2"></i> Filtros de Busca</h3>
        <form action="/tibl/buscairmao" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; align-items: flex-end;">
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Nome</label>
                <input type="text" name="nomev" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Apelido</label>
                <input type="text" name="apelidov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Município</label>
                <select name="municipiov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">------------</option>
                    {% if listamunicipios %}
                        {% for x, y in listamunicipios.items %}
                            <option value="{{ x }}">{{ y }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Profissão</label>
                <select name="profissaov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">------------</option>
                    {% if listaprofissoes %}
                        {% for x in listaprofissoes %}
                            <option value="{{ x.id }}">{{ x.designacao }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <input type="hidden" name="pagina" value="1">
            <button type="submit" class="bt-primary" style="padding: 0.6rem;">
                <i class="fas fa-search"></i> Buscar
            </button>
        </form>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Lista de Irmãos</h2>
        <a href="/tibl/irmaos/criar/" class="bt-primary" style="padding: 0.5rem 1.5rem; font-size: 0.9rem; background-color: var(--accent); color: var(--primary-dark);">
            <i class="fas fa-plus"></i> Novo Irmão
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Nome Completo</th>
                    <th style="text-align: center;">Telefone</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600;">{{ x.nome }} {{ x.outrosnomes}} {{ x.apelido }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Membro Registado</div>
                    </td>
                    <td style="text-align: center; color: var(--text-muted);">
                        <i class="fas fa-phone-alt" style="font-size: 0.8rem; margin-right: 0.3rem;"></i> {{ x.telefone }}
                    </td>
                    <td style="text-align: right;">
                        <a href="/tibl/irmaos/detalhe/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--bg-sidebar);">
                            <i class="fas fa-eye"></i> Detalhes
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 3rem;">
        <i class="fas fa-user-slash" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted);">Nenhum irmão encontrado com os filtros aplicados.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
