{% extends 'index.html' %}
{% block Saidabancos %}

<div class="list-container">
    <div class="modern-card" style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;"><i class="fas fa-filter mr-2"></i> Filtros de Saída (Banco)</h3>
        <form action="/tibl/buscasaidasbanco" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; align-items: flex-end;">
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Conta Origem</label>
                <select name="contabancariav" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">Qualquer</option>
                    {% if listacontasigreja %}
                        {% for x in listacontasigreja %}
                            <option value="{{ x.id }}">{{ x.numeroconta }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Rubrica</label>
                <select name="rubricav" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">Qualquer</option>
                    {% if listarubricassaida %}
                        {% for x in listarubricassaida %}
                            <option value="{{ x.id }}">{{ x.designacao }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Mês/Ano</label>
                <div style="display: flex; gap: 0.5rem;">
                    <select name="mesv" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                        <option value="0">Mês</option>
                        {% if listameses %}
                            {% for x, y in listameses.items %}
                                <option value="{{ x }}">{{ y }}</option>
                            {% endfor %}
                        {% endif %}
                    </select>
                    <input type="number" name="anov" value="2025" style="width: 80px; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                </div>
            </div>
            <input type="hidden" name="pagina" value="1">
            <button type="submit" class="bt-primary" style="padding: 0.6rem;">
                <i class="fas fa-search"></i> Filtrar
            </button>
        </form>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Fluxo de Saída - Bancos</h2>
        <a href="/tibl/saidabancos/criar/" class="bt-primary" style="background-color: #ef4444; color: white;">
            <i class="fas fa-minus-circle"></i> Nova Saída
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Conta Origem</th>
                    <th>Rubrica / Aquisição</th>
                    <th style="text-align: right;">Montante (Kz)</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600;">{{ x.data|date:"d/m/Y"|default:x.data }}</div>
                    </td>
                    <td>
                        <div style="font-size: 0.85rem; font-weight: 500;">{{ x.conta }}</div>
                    </td>
                    <td>
                        <div style="font-weight: 600; color: #991b1b;">{{ x.aquisicao.rubrica }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">{{ x.aquisicao.requisicao }}</div>
                    </td>
                    <td style="text-align: right; color: #ef4444; font-weight: 700;">
                        - {{ x.montante|floatformat:2 }}
                    </td>
                    <td style="text-align: right;">
                        <a href="/tibl/saidabancos/detalhe/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--bg-sidebar);">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 4rem;">
        <i class="fas fa-file-invoice-dollar" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 1.5rem;"></i>
        <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Sem Saídas Bancárias</h3>
        <p style="color: var(--text-muted);">Não encontramos registos de saídas bancárias para a sua pesquisa.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
