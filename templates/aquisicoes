{% extends 'index.html' %}
{% block Ajudas %}

<div class="list-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
            <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Gestão de Aquisições</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Registos de processos de aquisição e ajudas financeiras.</p>
        </div>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Beneficiário</th>
                    <th>Tipo de Aquisição / Ajuda</th>
                    <th style="text-align: center;">Data do Processo</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: var(--text-main);">{{ x.beneficiario.nome }}</div>
                        <div style="font-size: 0.7rem; color: var(--text-muted);">Membro Registado</div>
                    </td>
                    <td>
                        <span style="font-weight: 500; color: var(--primary-dark);">{{ x.tipo }}</span>
                    </td>
                    <td style="text-align: center; color: var(--text-muted);">
                        {{ x.data|date:"d/m/Y"|default:x.data }}
                    </td>
                    <td style="text-align: right;">
                        <a href="{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--info);">
                            <i class="fas fa-eye"></i> Ver Detalhes
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 4rem;">
        <i class="fas fa-shopping-cart" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 1.5rem;"></i>
        <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Nenhuma Aquisição Registada</h3>
        <p style="color: var(--text-muted);">Não encontramos processos de aquisição no sistema.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
