{% extends 'index.html' %}
{% block Cestas %}

<div class="list-container">
    <div class="modern-card" style="margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">
        <h3 style="margin-bottom: 1.5rem; text-align: center;"><i class="fas fa-search-plus mr-2"></i> Filtrar Cestas</h3>
        <form action="/tibl/buscacestas" method="GET" style="display: flex; gap: 1rem; align-items: flex-end; justify-content: center;">
            <div style="flex: 1;">
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Mês</label>
                <select name="mesv" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">Qualquer</option>
                    {% if listameses %}
                        {% for x, y in listameses.items %}
                            <option value="{{ x }}">{{ y }}</option>
                        {% endfor %}
                    {% endif %}
                </select>
            </div>
            <div style="flex: 1;">
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Ano</label>
                <select name="anov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
                    <option value="0">Qualquer</option>
                    <option value="2024">2024</option>
                    <option value="2025" selected>2025</option>
                    <option value="2026">2026</option>
                </select>
            </div>
            <input type="hidden" name="pagina" value="1">
            <button type="submit" class="bt-primary" style="padding: 0.65rem 1.25rem;">
                <i class="fas fa-filter"></i>
            </button>
        </form>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Gestão de Cestas Básicas</h2>
        <a href="/tibl/cestas/criar/" class="bt-primary" style="background-color: var(--accent); color: var(--primary-dark);">
            <i class="fas fa-plus"></i> Nova Distribuição
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table" style="max-width: 800px; margin: 0 auto;">
            <thead>
                <tr>
                    <th>Código / Identificação</th>
                    <th style="text-align: right;">Valor Disponibilizado (Kz)</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td style="font-weight: 600; color: var(--primary-dark);">
                        <i class="fas fa-box-open" style="margin-right: 0.5rem; opacity: 0.5;"></i> {{ x.codigo }}
                    </td>
                    <td style="text-align: right; font-family: 'Inter', sans-serif; font-weight: 600;">
                        {{ x.valordisponibilizado|floatformat:2 }}
                    </td>
                    <td style="text-align: right;">
                        <a href="/tibl/cestas/detalhe/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--bg-sidebar);">
                            <i class="fas fa-list-ul"></i> Conteúdo
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 4rem; max-width: 600px; margin: 0 auto;">
        <i class="fas fa-shopping-basket" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 1.5rem;"></i>
        <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Sem Cestas Registadas</h3>
        <p style="color: var(--text-muted);">Não encontramos registos de cestas para o período selecionado.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
