{% extends 'index.html' %}
{% block Escalas %}

<div class="list-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--primary-light); padding-bottom: 1rem;">
        <div>
            <h2 style="font-family: 'Inter', sans-serif; font-size: 1.75rem; color: var(--text-main);">Gestão de Escalas</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem;">Organização de membros por actividade e função.</p>
        </div>
        <a href="/tibl/escalas/criar/" class="bt-primary" style="background-color: var(--accent); color: var(--primary-dark); padding: 0.8rem 1.5rem;">
            <i class="fas fa-calendar-plus"></i> Nova Escala
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Irmão / Membro</th>
                    <th>Actividade</th>
                    <th style="text-align: center;">Função</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: var(--primary-dark);">{{ x.irmao.nome }} {{ x.irmao.apelido }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">ID: {{ x.irmao.id }}</div>
                    </td>
                    <td>
                        <div style="font-weight: 500;">{{ x.actividade }}</div>
                    </td>
                    <td style="text-align: center;">
                        <span style="background: var(--primary-light); color: var(--primary-dark); padding: 4px 12px; border-radius: 8px; font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(84, 140, 47, 0.2);">
                            {{ x.funcao }}
                        </span>
                    </td>
                    <td style="text-align: right;">
                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                            <a href="/tibl/escalas/actualizar/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.6rem; font-size: 0.8rem; background: var(--bg-sidebar);">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/tibl/escalas/eliminar/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.6rem; font-size: 0.8rem; background: #ef4444;">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 4rem;">
        <i class="fas fa-clipboard-list" style="font-size: 4rem; color: #e2e8f0; margin-bottom: 1.5rem;"></i>
        <h3 style="color: var(--text-main); margin-bottom: 0.5rem;">Sem Escalas Ativas</h3>
        <p style="color: var(--text-muted);">Não existem escalas de serviço registadas para este período.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
