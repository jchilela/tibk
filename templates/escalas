{% extends 'index.html' %}
{% block Escalas %}

<table cellpadding="0" cellspacing="0" align="center" width="15%" border="0">
<form action="/tibl/buscaescalas"  method="GET">
<tr align="center" style="font-family: bold verdana,arial,sans-serif;font-size: 80%;">
<td>Activdade</td><td>Função</td>
</tr>
<tr align="center">
<td><input type="text" name="actividade" style="width: 100px; border: 1px solid gray"></td>
<td><input type="text" name="funcao" style="width: 150px; border: 1px solid gray"></td>
<input type="hidden" name="pagina" value= 1>
<td><input type="submit" name="" value="Busca" class="button"></td>
</tr>
</form>
</table>
    

<p align="center"><font face="arial,helvetica,verdana" color="#afa3a3"  size="3">[ <b>Escalas | <a href="/tibl/escalas/criar/" class = 'aa'>Nova </b></a>]</font>
</p>

{% if bb %}
<table  cellpadding="3" cellspacing="2" align="center" class = "a6" width="50%">
<tr bgcolor="#548c2f">
<td align="center"><a href=""><font face="verdana,arial,helvetica" size="3" color='#FFFFFF'><b>Irmão</b></font></a></td>
<td align="center"><a href=""><font face="verdana,arial,helvetica" size="3" color="#FFFFFF"><b>Actividade</b></font></a></td>
<td align="center"><a href=""><font face="verdana,arial,helvetica" size="3" color="#FFFFFF"><b>Função</b></font></a></td>
</td>
</tr>

{% for x in bb %}
{% if forloop.counter|divisibleby:2 %}
<tr bgcolor="f8f9fa">
{% else %}
<tr bgcolor="#d8f3dc">
{% endif %}

<td><font face="verdana,arial,helvetica" size="3"><a href="/tibl/escalas/detalhe/{{ x.id }}" class = 'aa'>{{ x.irmao.nome }} {{ x.irmao.apelido }} </a></font></td>
<td align="center"><font face="verdana,arial,helvetica" size="3" color = "#6E684F">{{ x.actividade }}</font></td>
<td align="center"><font face="verdana,arial,helvetica" size="3" color = "#6E684F">{{ x.funcao }}</font></td>
</tr>
{% endfor %}

</table>
<br>
{% include 'paginacao' %}
{% else %}

<p align = "center"><font face="verdana,arial,helvetica" size="3" color = "#6E684F">Nenhum registo encontrado!!!</font></p>

{% endif %}
<br>
<br>


{% endblock %}

