{% extends 'index.html' %}
{% block InventarioPatrimonio %}

<div class="list-container">
    <div class="modern-card" style="margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.5rem;"><i class="fas fa-search mr-2"></i> Procurar no Património</h3>
        <form action="/tibl/buscainventariopatrimonio" method="GET" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; align-items: flex-end;">
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Nome do Bem</label>
                <input type="text" name="nomev" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Descrição</label>
                <input type="text" name="descricaov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <div>
                <label style="display: block; font-size: 0.8rem; margin-bottom: 0.4rem; color: var(--text-muted);">Código de Inventário</label>
                <input type="text" name="codigov" style="width: 100%; padding: 0.6rem; border: 1px solid #ddd; border-radius: var(--radius-sm);">
            </div>
            <input type="hidden" name="pagina" value="1">
            <button type="submit" class="bt-primary" style="padding: 0.6rem;">
                <i class="fas fa-search"></i> Pesquisar
            </button>
        </form>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-family: 'Inter', sans-serif; font-size: 1.5rem; color: var(--text-main);">Inventário de Património</h2>
        <a href="/tibl/inventariopatrimonio/criar/" class="bt-primary" style="padding: 0.5rem 1.5rem; font-size: 0.9rem; background-color: var(--accent); color: var(--primary-dark);">
            <i class="fas fa-plus"></i> Novo Bem
        </a>
    </div>

    {% if bb %}
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Designação do Bem</th>
                    <th style="text-align: center;">Código</th>
                    <th style="text-align: center;">Qtd</th>
                    <th style="text-align: right;">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for x in bb %}
                <tr>
                    <td>
                        <div style="font-weight: 600; color: var(--primary-dark);">{{ x.nome }}</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">{{ x.descricao|truncatechars:40 }}</div>
                    </td>
                    <td style="text-align: center;">
                        <span style="font-family: monospace; background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px; border: 1px solid #e2e8f0; font-size: 0.85rem;">{{ x.codigo }}</span>
                    </td>
                    <td style="text-align: center;">
                        <span style="font-weight: 700;">{{ x.quantidade }}</span>
                    </td>
                    <td style="text-align: right;">
                        <a href="/tibl/inventariopatrimonio/detalhe/{{ x.id }}" class="bt-primary" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: var(--bg-sidebar);">
                            <i class="fas fa-boxes"></i> Ficha Técnica
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    
    <div style="margin-top: 2rem;">
        {% include 'paginacao' %}
    </div>
    {% else %}
    <div class="modern-card" style="text-align: center; padding: 3rem;">
        <i class="fas fa-toolbox" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
        <p style="color: var(--text-muted);">Nenhum bem patrimonial localizado.</p>
    </div>
    {% endif %}
</div>

{% endblock %}
